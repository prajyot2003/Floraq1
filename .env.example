# GROQ_API_KEY: Required for Groq AI vision diagnostics and growth projection calls.
# Configure this in AI Studio Secrets or a local .env file (kept strictly server-side).
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE REALTIME DATABASE (Phytopod 360 Telemetry & Irrigation Controls)
# Provide your existing Firebase Web App configuration via Secrets / environment variables.
# Never place Firebase Admin SDK private keys or service-account JSON in VITE_ variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

